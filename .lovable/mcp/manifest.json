{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "yala-playstation-mcp",
      "version": "0.1.0",
      "title": "YALA PlayStation MCP"
    },
    "tools": [
      {
        "name": "list_machines",
        "title": "List machines",
        "description": "List all PS5 machines with their zone (sofa/racing), machine number, and current status (idle or playing).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_active_reservations",
        "title": "List active reservations",
        "description": "List all currently playing reservations with customer name, zone, machine number, hours, advance payments, and end time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "revenue_report",
        "title": "Revenue report",
        "description": "Get billing/revenue summary for a date range (YYYY-MM-DD). Returns totals for cash, transfer, machine revenue, food revenue, and per-day breakdown.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date, YYYY-MM-DD"
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date, YYYY-MM-DD (inclusive)"
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
