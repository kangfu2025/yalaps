# API key ของ EasySlip สำหรับตรวจสลิปโอนเงิน
# อยู่ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่คำนำหน้า VITE_ เพราะจะหลุดไปฝั่งเบราว์เซอร์
# หาได้จาก https://developer.easyslip.com  (เมนู API Key)
EASYSLIP_API_KEY=

# service role key ของ Supabase (ใช้โดย /api/admin-users)
YALA_SERVICE_ROLE_KEY=

# Channel access token ของ LINE Official Account (Messaging API) สำหรับส่งแจ้งเตือน
# LINE Notify ปิดบริการแล้วตั้งแต่ 31 มี.ค. 2568 ต้องใช้ Messaging API แทน
# หาได้จาก LINE Developers Console > ช่อง Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
