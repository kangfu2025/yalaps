<Window x:Class="YalaPcAgent.LockScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YALA" WindowStyle="None" WindowState="Maximized"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B0F17" Foreground="White" FontFamily="Segoe UI"
        Loaded="OnLoaded">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🎮" FontSize="120" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="YALA PLAYSTATION" FontSize="72" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#22D3EE"/>
            <TextBlock x:Name="MessageText" FontSize="28" HorizontalAlignment="Center"
                       Margin="0,40,0,0" Foreground="#E2E8F0"
                       Text="กรุณาติดต่อพนักงานเพื่อเปิดเครื่อง"/>
            <TextBlock x:Name="MachineText" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,24,0,0" Foreground="#F59E0B"/>
            <TextBlock x:Name="StatusText" FontSize="14" HorizontalAlignment="Center"
                       Margin="0,60,0,0" Foreground="#475569"/>
        </StackPanel>

        <!-- Shutdown button (bottom-right corner, subtle) -->
        <Button x:Name="ShutdownBtn" Content="⏻ ปิดเครื่อง"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Padding="18,10"
                Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155"
                FontSize="14" Cursor="Hand"
                Click="OnShutdownClick"/>
    </Grid>
</Window>
